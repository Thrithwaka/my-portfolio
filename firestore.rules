rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'thrithwakapreethi57@gmail.com' ||
        request.auth.token.email == 'ayourdomain@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Helpers ---
    function isValidHero(data) {
      return data.keys().hasAll(['title']) &&
             data.title is string && data.title.size() <= 200;
    }
    function isValidAbout(data) {
      return (!('bio' in data) || (data.bio is string && data.bio.size() <= 5000));
    }
    function isValidEndorsement(data) {
      return data.keys().hasAll(['name', 'quote']);
    }
    function isValidSkill(data) {
      return data.keys().hasAll(['name']);
    }
    function isValidResearch(data) {
      return data.keys().hasAll(['title']);
    }
    function isValidBlogPost(data) {
      return data.keys().hasAll(['platform', 'url']) &&
             data.platform in ['Medium', 'Google Scholar', 'Other'];
    }
    function isValidProject(data) {
      return data.keys().hasAll(['title', 'slug', 'shortDescription']) && 
             data.title is string && data.title.size() <= 200 &&
             data.slug is string && data.slug.size() <= 200 &&
             data.shortDescription is string && data.shortDescription.size() <= 1000 &&
             (!('fullDescription' in data) || (data.fullDescription is string && data.fullDescription.size() <= 20000)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('status' in data) || (data.status in ['Completed', 'Ongoing', 'Experimental'])) &&
             (!('techStack' in data) || (data.techStack is list && data.techStack.size() <= 50)) &&
             (!('isFeatured' in data) || (data.isFeatured is bool)) &&
             (!('priority' in data) || (data.priority is int));
    }
    function isValidContributor(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() <= 200 &&
             (!('role' in data) || (data.role is string && data.role.size() <= 200)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 2000)) &&
             (!('linkedInUrl' in data) || (data.linkedInUrl is string && data.linkedInUrl.size() <= 1000)) &&
             (!('priority' in data) || (data.priority is int));
    }
    function isValidMedia(data) {
      return data.keys().hasAll(['url', 'type']) &&
             data.url is string && data.url.size() <= 2000 &&
             data.type in ['image', 'video', 'diagram'];
    }
    function isValidProjectSection(data) {
      return data.keys().hasAll(['title', 'content']) &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000;
    }
    function isValidCertification(data) {
      return data.keys().hasAll(['title', 'issuer', 'certificationType']) &&
             data.title is string && data.title.size() <= 200 &&
             data.issuer is string && data.issuer.size() <= 200 &&
             data.certificationType in ['Certificates', 'Badges', 'Achievements'] &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             (!('verificationUrl' in data) || (data.verificationUrl is string && data.verificationUrl.size() <= 1000)) &&
             (!('skills' in data) || (data.skills is list && data.skills.size() <= 20)) &&
             (!('isFeatured' in data) || (data.isFeatured is bool));
    }
    function isValidEducation(data) {
      return data.keys().hasAll(['institution', 'degree']) &&
             data.institution is string && data.institution.size() <= 200 &&
             data.degree is string && data.degree.size() <= 200;
    }
    function isValidSiteSettings(data) {
      return (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
             (!('linkedinUrl' in data) || (data.linkedinUrl is string && data.linkedinUrl.size() <= 1000)) &&
             (!('githubUrl' in data) || (data.githubUrl is string && data.githubUrl.size() <= 1000)) &&
             (!('scholarUrl' in data) || (data.scholarUrl is string && data.scholarUrl.size() <= 1000)) &&
             (!('mediumUrl' in data) || (data.mediumUrl is string && data.mediumUrl.size() <= 1000)) &&
             (!('cvUrl' in data) || (data.cvUrl is string && data.cvUrl.size() <= 1000)) &&
             (!('accentColor' in data) || (data.accentColor is string && data.accentColor.size() <= 50)) &&
             (!('orcidUrl' in data) || (data.orcidUrl is string && data.orcidUrl.size() <= 1000)) &&
             (!('researchGateUrl' in data) || (data.researchGateUrl is string && data.researchGateUrl.size() <= 1000)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp));
    }

    // --- Collection Rules ---
    match /sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(sectionId);
    }
    match /endorsements/{endorsementId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(endorsementId);
    }
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(skillId);
    }
    match /blog/{postId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(postId);
    }
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(projectId) && isValidProject(incoming());
      
      match /contributors/{contributorId} {
        allow read: if true;
        allow write: if isAdmin() && isValidId(contributorId) && isValidContributor(incoming());
      }
      match /gallery/{mediaId} {
        allow read: if true;
        allow write: if isAdmin() && isValidId(mediaId) && isValidMedia(incoming());
      }
      match /sections/{sectionId} {
        allow read: if true;
        allow write: if isAdmin() && isValidId(sectionId) && isValidProjectSection(incoming());
      }
    }
    match /certifications/{certId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(certId);
    }
    match /education/{eduId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(eduId);
    }
    match /research/{projectId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(projectId);
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(serviceId);
    }
    match /settings/global {
      allow read: if true;
      allow write: if isAdmin() && isValidSiteSettings(incoming());
    }
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin() && isValidId(adminId);
    }
  }
}
